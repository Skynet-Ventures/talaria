  "clusterDefinitions": {
    "CLI00-merge-parent-integration": {
      "classification": "merge-integration",
      "disposition": "merge-integration",
      "talariaStatus": "none",
      "contract": "This merge is retained because every parent union touched non-web hermes_cli production paths; it has no independent mobile contract.",
      "evidence": "The checker recomputes every parent diff and requires the complete sorted path union for this commit.",
      "required": "Rely on constituent evidence; do not create a duplicate phone feature for merge topology."
    },
    "CLI01-dashboard-desktop-surface": {
      "classification": "desktop-only",
      "disposition": "desktop-only",
      "talariaStatus": "none",
      "contract": "Dashboard PKCE cookies, direct-voice credentials, browser extension control, desktop process guards, and Linux HUD behavior are desktop or local-dashboard concerns.",
      "evidence": "These paths are dashboard_auth, dashboard_procs, Linux desktop entry, or exact desktop-only configuration commits; they do not add a bounded authenticated Talaria wire.",
      "required": "Keep Talaria server-mediated and credential-minimal; verify only through the host/desktop surface."
    },
    "CLI02-host-update-lifecycle": {
      "classification": "gateway-host-runtime",
      "disposition": "host-cli-only",
      "talariaStatus": "none",
      "contract": "Launcher repair, package and venv handling, process ownership, systemd/launchd handoff, backups, and fleet restart behavior execute on the gateway host.",
      "evidence": "The affected commands inspect local PIDs, services, filesystems, installers, and code trees rather than exposing a bounded mobile action/result contract.",
      "required": "Exercise host update/lifecycle regressions; do not mirror local process management in Talaria."
    },
    "CLI03-pr91-durable-update-recovery": {
      "classification": "durable-host-update-recovery",
      "disposition": "covered-by-pr91-excluded",
      "talariaStatus": "pr91-excluded",
      "contract": "Durable update action receipts and bounded recovery status are already owned by Talaria PR91, not this CLI delta ledger.",
      "evidence": "PR91 review head 733b9621228b375f15c4132046ef750c56489f94 retains implementation cc3322f674ac388c55a9d2694efaaf7e941a1666; raw update plans remain host-local inventory rather than a mobile-safe projection.",
      "required": "Do not add a second update/restart path. Any future plan read needs separately bounded, authenticated, redacted authority."
    },
    "CLI04-provider-catalog-host-runtime": {
      "classification": "gateway-host-runtime",
      "disposition": "dynamic-catalog-already-consumed",
      "talariaStatus": "existing-model-options-consumer",
      "contract": "Provider credentials, inference routing, catalog contents, pricing, and capability discovery remain gateway-owned; Talaria consumes the dynamic model.options result.",
      "evidence": "The range changes hermes_cli model/auth/inventory/runtime modules, while Talaria already decodes gateway-provided model options instead of shipping a static provider routing table.",
      "required": "Refresh against a live authenticated catalog; do not add provider credential or routing mutations from the phone."
    },
    "CLI05-pr94-model-presentation": {
      "classification": "portable-mobile-presentation",
      "disposition": "merged-to-parent-not-main-uncertified",
      "talariaStatus": "pr94-parent-merged-not-main-uncertified",
      "contract": "The exact search aliases and bounded sale presentation are read-only model-options presentation, never model selection authority.",
      "evidence": "PR94 implementation ff0ea1a6e91c3af0996f406dac0acf9f607cc166, merged into parent branch codex/model-contract-copy as 5cb68d2dd38539b2f5de789e7be95a545437ca22, adds x-preview-f-free search aliases and renders only finite integral 1...100 discount_percent values in both pickers.",
      "required": "Treat PR94 as parent-merged but not in main or certified until parent PR67 CI/review and focused Swift/device integration certification land."
    },
    "CLI06-cli-local-management": {
      "classification": "host-cli-runtime",
      "disposition": "host-cli-only",
      "talariaStatus": "none",
      "contract": "Parser, curses, setup, local curation, diagnostics formatting, FTS repair, and command-line fallbacks are host CLI ergonomics or maintenance behavior.",
      "evidence": "No bounded authenticated mobile endpoint or structured response is introduced by these local command paths.",
      "required": "Keep the behavior on the host CLI; mobile consumes existing gateway state only where a separately proven wire exists."
    },
    "CLI07-plugin-dashboard-host": {
      "classification": "dashboard-plugin-host",
      "disposition": "host-cli-only",
      "talariaStatus": "none",
      "contract": "Plugin registry lifecycle and dashboard-auth registration cleanup are process-global host/dashboard management, not plugin capability wire changes.",
      "evidence": "The affected plugins.py and dashboard registry paths do not add a bounded plugins.manage result or mobile-safe mutation receipt.",
      "required": "Do not expose plugin lifecycle mutation from Talaria without a new authenticated bounded plugin authority."
    },
    "CLI08-profile-peer-host-safety": {
      "classification": "gateway-host-runtime",
      "disposition": "verify-on-host",
      "talariaStatus": "none",
      "contract": "Non-multiplex profile refusal and host peer-DM repair protect server routing or use host-held peer credentials; neither becomes a phone federation contract.",
      "evidence": "profile_matches_home fails closed on an invalid multiplex route, while hermes peer dm targets a remote host API using local peer configuration.",
      "required": "Regression-test routing and peer behavior on hosts; do not infer a mobile cross-connection mutation authority."
    },
    "CLI09-bot-cron-existing-wire": {
      "classification": "portable-mobile-runtime",
      "disposition": "already-portable",
      "talariaStatus": "existing-generic-cron-delivery",
      "contract": "bot-chat:<profile> delivery is a gateway-advertised cron delivery target that Talaria already handles generically.",
      "evidence": "PR85 authority records a2da0ab797edf5e7ca7d3f64591facbbc37ec7f2 and Talaria uses generic CronDeliveryTarget/RoutineEditor delivery selection.",
      "required": "Live-prove a resolved profile receives the delivery and agent reply; no iOS mutation code is required."
    },
    "CLI10-one-shot-rearm-contract": {
      "classification": "upstream-contract",
      "disposition": "upstream-contract-blocked",
      "talariaStatus": "none",
      "contract": "Hermes CLI can re-arm a completed one-shot, but the authenticated gateway exposes only list/add/remove/pause/resume; it has no rearm wire.",
      "evidence": "cron.jobs.rearm_oneshot exists, cron.resume invokes it, terminal update_job rejects activation, and tui_gateway cron.manage rejects every action outside remove/pause/resume.",
      "required": "Require a profile-scoped authenticated rearm verb using canonical job ID, mutually exclusive server-now or bounded ISO run_at, server-side one-shot/live-claim checks, and a canonical job postcondition plus revision or mutation receipt before any mobile mutation."
    },
    "CLI11-predecessor-covered": {
      "classification": "predecessor-covered",
      "disposition": "covered-by-predecessor",
      "talariaStatus": "none",
      "contract": "This exact upstream commit already has a PR85, PR90, or PR93 ledger row; the predecessor reference names the pinned ledger and cluster.",
      "evidence": "The checker reads predecessor TSVs at their immutable local heads and rejects a missing, changed, or ambiguous reference.",
      "required": "Keep the predecessor owner and its verification plan; this CLI ledger adds no duplicate work."
    }
