  "exclusionJustifications": [
    {
      "category": "authority",
      "rule": "PR85 exact authority files (all are Desktop/docs in this range)",
      "reason": "Already owned by the authority ledger; overlapping Desktop/docs paths are not residual production."
    },
    {
      "category": "client-wire",
      "rule": "tui_gateway/** and hermes_cli web wire are predecessor client-wire scope",
      "reason": "PR90 owns authenticated gateway method/endpoint contracts; leaving them here would double count wire authority."
    },
    {
      "category": "core-runtime",
      "rule": "30 exact PR93 core runtime paths",
      "reason": "PR93 owns the listed agent/cron/tools runtime paths; only non-overlapping residual runtime files remain."
    },
    {
      "category": "desktop",
      "rule": "apps/desktop/**",
      "reason": "Desktop/Electron renderer and host runtime are owned by the current Desktop manifest."
    },
    {
      "category": "cli",
      "rule": "hermes_cli/**",
      "reason": "The current CLI manifest owns all Hermes CLI production paths, including non-web code."
    },
    {
      "category": "gateway-platform",
      "rule": "gateway/**",
      "reason": "Gateway/platform production code is owned by the current gateway/platform manifest."
    },
    {
      "category": "tests-fixtures",
      "rule": "test/tests/__tests__/fixture/fixtures components and test filename patterns",
      "reason": "Tests and fixtures are verification material, not residual production behavior."
    },
    {
      "category": "docs-locales",
      "rule": "docs/doc/website/locales/locale/i18n components and prose/localization extensions",
      "reason": "Documentation and translation-only changes do not create runtime/mobile contracts."
    },
    {
      "category": "styles-assets",
      "rule": "style and binary/static asset extensions plus assets/static/dist components",
      "reason": "Styling and generated/static media are not executable production runtime sources for this audit."
    },
    {
      "category": "build-config-lock",
      "rule": "build components, config filename pattern, package/build names, JSON/YAML/TOML/lock extensions",
      "reason": "Build metadata, configuration, and lockfiles do not independently establish a portable runtime contract."
    },
    {
      "category": "non-runtime",
      "rule": "outside named roots or non-source extension; top level admits Python only",
      "reason": "Keeps the residual bounded to executable implementation while still covering named production roots and runtime Python entrypoints."
    }
  ],
