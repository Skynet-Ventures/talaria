# talaria-push-relay — example environment
#
# In-process plugin mode: export these in the environment of every hermes
# process that should push (hermes serve / hermes gateway / hermes cron),
# e.g. via the systemd unit or the shell profile that launches hermes.
# Environment is inherited by child processes; it is not shared with an
# already-running daemon or a separately managed unit. Restart each unit after
# changing this file. Sidecar mode is another process with its own environment;
# the same file works for `talaria-push-sidecar` (systemd EnvironmentFile=
# friendly — no quotes needed).

# ── APNs credentials (required for any push) ────────────────────────────────
# Auth-key (.p8) token auth from developer.apple.com → Keys → Apple Push
# Notifications service. NEVER commit the .p8; chmod 600 it.
TALARIA_APNS_KEY_P8_PATH=~/.hermes/talaria-push/AuthKey_ABC123DEFG.p8
TALARIA_APNS_KEY_ID=ABC123DEFG
TALARIA_APNS_TEAM_ID=TEAM123456
# The signed iOS app bundle id (apns-topic header). This must exactly equal
# PRODUCT_BUNDLE_IDENTIFIER in the build sent to the device/TestFlight.
TALARIA_APNS_TOPIC=bot.talaria.ios
# Default APNs environment only for devices whose registration omitted it:
#   Debug/Xcode + aps-environment=development -> dev -> api.sandbox.push.apple.com
#   TestFlight/App Store + aps-environment=production -> prod -> api.push.apple.com
# The device registration's environment is authoritative when present. Sandbox
# and production tokens are different; do not reuse a Debug token for
# TestFlight.
TALARIA_APNS_ENV=dev

# ── Relay behaviour ─────────────────────────────────────────────────────────
# Which live event kinds THIS process may push. Comma list from:
#   approval, long_task, response, mention, gateway
# `routine` is intentionally not a live producer: Hermes does not expose
# immutable creator/delivery provenance, so Slack-owned cron must fail closed.
# If TALARIA_PUSH_EVENTS is omitted, the five safe live kinds above are enabled.
# This is a process-wide allow-list, not a per-device/per-kind setting.
# Hook mode emits `response` for a non-empty, non-interrupted final response
# only when the client stamps the session platform `talaria` (Talaria
# GatewayClient) or `desktop` (Desktop chat panel). Standalone TUI, messaging
# adapters, CLI, server/tool, subagent, relay, cron, missing, and unknown
# platforms fail closed. When response is enabled, the legacy duration-only
# `long_task` push is suppressed. The sidecar has no post_llm_call producer, so
# sidecar-only mode must explicitly omit `response` if it needs polling-based
# long_task notifications.
# Recommended split when running hook mode + sidecar together (avoids
# double pushes — see README "Two modes"):
#   hermes processes (hook mode):  approval,response,mention
#   sidecar:                       gateway
# Sidecar-only deployments (no plugin installed): approval,long_task,gateway
#TALARIA_PUSH_EVENTS=approval,response,mention

# Kill switch: set to 1 to disable all pushes from this process.
#TALARIA_PUSH_DISABLE=0

# "Long task done" threshold in seconds (default 600 = 10 minutes).
#TALARIA_PUSH_LONG_TASK_MIN_S=600

# @handles that count as a mention of this bot in inbound gateway messages
# (comma list, without the @). Default: the current profile name.
#TALARIA_PUSH_MENTION_HANDLES=ops-bot,opsbot

# Approval surfaces that should push (comma list of gateway,cli,smart).
# Default "gateway" — CLI approvals mean a human is already at the
# terminal, and "smart" approvals are auto-decided by the auxiliary LLM.
#TALARIA_PUSH_APPROVAL_SURFACES=gateway

# Bot name override for push attribution in a hook process (default: the
# hermes profile name, derived from HERMES_HOME). The sidecar defaults to
# "hermes" and is not profile-aware for approval/long-task polling; do not
# treat it as a substitute for one hook-loaded process per profile.
#TALARIA_PUSH_BOT_NAME=

# ── Sidecar mode only ───────────────────────────────────────────────────────
# The `hermes serve` gateway to watch.
TALARIA_GATEWAY_URL=http://127.0.0.1:9119
# Dashboard session token. Leave empty on loopback to auto-scrape
# window.__HERMES_SESSION_TOKEN__ from GET / (the token the served SPA
# embeds; it rotates on every server restart). Set explicitly when the
# server was started with HERMES_DASHBOARD_SESSION_TOKEN pinned.
#TALARIA_GATEWAY_TOKEN=
# /api/health polling cadence and how many consecutive failures mean
# "gateway offline".
#TALARIA_PUSH_HEALTH_INTERVAL_S=15
